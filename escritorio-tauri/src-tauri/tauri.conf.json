{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kodama",
  "version": "1.0.0",
  "identifier": "app.companero.escritorio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Kodama",
        "url": "index.html",
        "width": 400,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,OptimizationHints,AutofillServerCommunication,MediaRouter --disable-background-networking --disable-component-update --disable-sync --no-first-run --renderer-process-limit=1 --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8787 http://127.0.0.1:8788 http://127.0.0.1:8789 http://127.0.0.1:8790 http://127.0.0.1:8791 http://127.0.0.1:8792 http://127.0.0.1:8793 http://127.0.0.1:8794 http://127.0.0.1:8795 http://127.0.0.1:8796 http://127.0.0.1:8797 http://127.0.0.1:8798 http://127.0.0.1:8799"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "LShinox",
    "copyright": "© 2026 LShinox",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"]
  }
}
